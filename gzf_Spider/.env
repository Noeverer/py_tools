# =============================================================================
# 上海公租房信息监控平台 - 环境变量配置示例
# =============================================================================
# 
# 使用方法：
# 1. 复制此文件为 .env
# 2. 修改相应的配置值
# 3. 在运行程序前加载环境变量：export $(cat .env | xargs)
# =============================================================================

# =============================================================================
# Bark推送配置
# =============================================================================

# Bark推送服务密钥（必填）
BARK_KEY=vWYmRcVLnFKWJP5AJKWADU

# 默认分组名称
BARK_DEFAULT_GROUP=公租房通知

# Bark服务器地址（支持自建服务器）
BARK_SERVER_URL=https://api.day.app

# 默认推送声音
BARK_SOUND=telegraph

# 测试推送声音
BARK_TEST_SOUND=calypso

# 推送图标URL
BARK_ICON=https://raw.githubusercontent.com/Finb/Bark/refs/heads/master/Server/assets/favicon.ico

# 推送级别：active, passive, timeSensitive
BARK_LEVEL=active

# 推送分类
BARK_CATEGORY=house_notification

# 是否自动复制内容
BARK_AUTO_COPY=false

# =============================================================================
# 推送时间控制
# =============================================================================

# 是否启用推送时间控制
PUSH_TIME_ENABLED=true

# 推送时间段设置（支持多时间段，用逗号分隔）
# 格式：开始小时-结束小时
PUSH_TIME_SLOTS=8-11,19-21

# 单时间段设置（兼容旧配置）
PUSH_START_HOUR=8
PUSH_END_HOUR=11

# 时区设置
PUSH_TIMEZONE=Asia/Shanghai

# =============================================================================
# 爬虫配置
# =============================================================================

# 页面加载延迟（秒）
CRAWLER_DELAY=5

# 最大重试次数
CRAWLER_MAX_RETRIES=3

# 请求超时时间（秒）
CRAWLER_TIMEOUT=30

# 目标URL
CRAWLER_TARGET_URL=https://select.pdgzf.com/houseLists

# 是否使用无头模式
CRAWLER_HEADLESS=true

# 是否禁用沙箱
CRAWLER_NO_SANDBOX=true

# =============================================================================
# 数据存储配置
# =============================================================================

# 数据存储目录
DATA_DIR=data/

# 日志存储目录
LOGS_DIR=logs/

# 数据备份天数
DATA_BACKUP_DAYS=30

# 最大文件大小（字节）
DATA_MAX_FILE_SIZE=10485760

# =============================================================================
# 筛选配置
# =============================================================================

# 默认筛选条件
FILTER_MIN_RENT=
FILTER_MAX_RENT=5000
FILTER_AREA=
FILTER_HOUSE_TYPE=

# 启用的预设筛选方案（用逗号分隔）
ENABLED_PRESET_FILTERS=金桥低价

# 自定义筛选方案
# 格式：区域:区域名,max_rent:最高租金,min_rent:最低租金,house_type:房型
PRESET_FILTER_金桥低价=area:金桥,max_rent:3000
PRESET_FILTER_张江低价=area:张江,max_rent:3000
PRESET_FILTER_一室户=house_type:1室1厅,max_rent:3500

# =============================================================================
# 其他配置
# =============================================================================

# 监控地点（用逗号分隔）
MONITORED_LOCATIONS=张江,唐镇,曹路,合庆,金桥,陆家嘴,金杨新村,洋泾,花木,康桥

# 是否启用测试推送
TEST_PUSH_ENABLED=true

# 测试推送间隔（秒）
TEST_PUSH_INTERVAL=3600

# =============================================================================
# 使用示例
# =============================================================================
# 
# 1. 基础配置：
#    export BARK_KEY=your_actual_key_here
#    export ENABLED_PRESET_FILTERS=金桥低价
# 
# 2. 多时间段推送：
#    export PUSH_TIME_SLOTS=8-11,19-21
# 
# 3. 自定义筛选：
#    export PRESET_FILTER_我的筛选=area:金桥,max_rent:2500,house_type:1室1厅
#    export ENABLED_PRESET_FILTERS=金桥低价,我的筛选
# 
# 4. 运行程序：
#    export $(cat .env | xargs)
#    python main.py
# =============================================================================
